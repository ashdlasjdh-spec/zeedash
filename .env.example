# =====================================================================
#  zhd.lol dashboard — example env. Copy to .env.local and fill in the
#  blanks. NEVER put real secrets in this file (it is committed to git).
# =====================================================================

# ---- Discord OAuth (user login) ----
DISCORD_CLIENT_ID=1531928709408227368
DISCORD_CLIENT_SECRET=            # Discord dev portal > your app > OAuth2 > Client Secret
DISCORD_REDIRECT_URI=https://zhd.lol/api/auth/callback
DISCORD_GUILD_ID=1531917648588312677
DISCORD_BOT_TOKEN=               # Discord dev portal > Bot > Token (reads member roles + posts dashboard actions to the log channel)
DISCORD_LOG_CHANNEL_ID=1533027437145882684   # channel every dashboard action is mirrored to (defaults to this if unset)
# Discord ROLE ID -> permission LEVEL (0-255), mirroring the bot's ladder so the site
# and bot whitelist identically. A member's level = the HIGHEST among their roles.
# Thresholds: 247+ grant powers/stands/car/tools/gamepasses, 254+ (co founders) crew
# tags + emojis, 242+ group management, 248+ bulk group ops, 251+ whitelist/settings.
# Only real ranks are mapped — cosmetic/non-rank roles (tj, hr, gamepass, @everyone)
# are intentionally left OUT so they never inflate someone's access.
DISCORD_ROLE_MAP={"1532298195965579356":255,"1532298197500825600":254,"1532298198628962386":253,"1532298199128084543":252,"1532298200168272005":251,"1532298201003200573":249,"1532298201564971080":248,"1532298202764804199":247,"1532298204081684480":246,"1532298204878602250":245,"1532298205738307734":244,"1532298206505861140":243,"1532298207449841808":242,"1532298209114718229":241,"1532298210285064232":240,"1532298211253813420":239,"1532298212214571018":238,"1532298213002842132":237,"1532298213938434059":236,"1532298216022872197":235,"1532298217226506382":234,"1532641885397585940":5,"1532600207911551086":14,"1532600209069183016":13,"1532600209824026826":12,"1532600210729992352":11,"1532600211770445968":10,"1531928800189743137":1,"1532598457150476340":1}

# ---- Session + break-glass owner ----
SESSION_SECRET=                  # any long random string (e.g. `openssl rand -base64 48`)
BOOTSTRAP_OWNER_IDS=1526337145063735461,183605754593411072

# ---- Roblox Open Cloud ----
ROBLOX_API_KEY=                  # create.roblox.com > Open Cloud > API key (DataStore + Messaging + Assets, no expiry)
ROBLOX_CREATOR_ID=11080769482    # Roblox user id that OWNS the API key (needed to upload crew-tag PNG icons as decals)
ROBLOX_UNIVERSE_ID=10631060249
ROBLOX_GROUP_ID=1099600954
ROBLOX_GROUP_COOKIE=             # .ROBLOSECURITY cookie (only needed for group kick) — include the full warning prefix

# ---- Bans (Open Cloud user restrictions) ----
# The Bans API key is normally set in the site's SETTINGS tab (co founders+ only) and
# stored in the DB. This env var is only a fallback if it isn't set there. The key needs
# the "universe.user-restriction" (Read+Write) scope. Bans apply to ROBLOX_UNIVERSE_ID —
# swap that and old bans stay behind (bans are per-universe, not mirrored to the DB).
ROBLOX_BAN_API_KEY=
# Discord webhook every ban/unban is logged to (as an embed). SET THIS ONE as an env var.
BAN_WEBHOOK_URL=

# ---- In-game grant topics ----
POWER_GRANT_TOPIC=DiscordAdminPowerGrantV1
POWER_REMOVE_TOPIC=DiscordAdminPowerRemoveV1
ADMIN_GRANT_TOPIC=DiscordAdminGrantV1
ADMIN_GRANT_REMOVE_TOPIC=DiscordAdminGrantRemoveV1

# ---- Database (same Postgres as the bot / perks-api) ----
DATABASE_URL=                    # postgresql://postgres:PASSWORD@HOST:PORT/railway (Railway public proxy URL)

# ---- Perks-api (crew tags) ----
PERKS_API_URL=https://idkutoldmetomakeit-production.up.railway.app
PERKS_API_SECRET=                # same value as the perks-api's PERKS_API_SECRET
