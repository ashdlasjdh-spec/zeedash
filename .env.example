# =====================================================================
#  zhd.lol dashboard — example env. Copy to .env.local and fill in the
#  blanks. NEVER put real secrets in this file (it is committed to git).
# =====================================================================

# ---- Discord OAuth (user login) ----
DISCORD_CLIENT_ID=1531928709408227368
DISCORD_CLIENT_SECRET=            # Discord dev portal > your app > OAuth2 > Client Secret
DISCORD_REDIRECT_URI=https://zhd.lol/api/auth/callback
DISCORD_GUILD_ID=1531917648588312677
DISCORD_BOT_TOKEN=               # Discord dev portal > Bot > Token (used to read member roles)
# Discord ROLE ID -> dashboard role (owner / cofounder / admin / staff)
DISCORD_ROLE_MAP={"1531928800189743137":"staff","1532298195965579356":"owner","1532298198628962386":"owner","1532298197500825600":"cofounder","1532298199128084543":"cofounder","1532298200168272005":"cofounder","1532298201003200573":"admin","1532298201564971080":"admin","1532298202764804199":"admin","1532298204081684480":"admin","1532298204878602250":"admin","1532298205738307734":"admin","1532298206505861140":"admin","1532298207449841808":"admin","1532739548264530070":"admin","1532298209114718229":"admin","1532298210285064232":"admin","1532298211253813420":"admin","1532298212214571018":"staff","1532298213002842132":"staff","1532298213938434059":"staff","1532298216022872197":"staff","1532298217226506382":"staff","1532641885397585940":"staff","1532600207911551086":"staff","1532600209069183016":"staff","1532600209824026826":"staff","1532600210729992352":"staff","1532600211770445968":"staff","1532598457150476340":"staff"}

# ---- Session + break-glass owner ----
SESSION_SECRET=                  # any long random string (e.g. `openssl rand -base64 48`)
BOOTSTRAP_OWNER_IDS=1526337145063735461,183605754593411072

# ---- Roblox Open Cloud ----
ROBLOX_API_KEY=                  # create.roblox.com > Open Cloud > API key (DataStore + Messaging + Assets, no expiry)
ROBLOX_UNIVERSE_ID=10604778261
ROBLOX_GROUP_ID=1099600954
ROBLOX_GROUP_COOKIE=             # .ROBLOSECURITY cookie (only needed for group kick) — include the full warning prefix

# ---- In-game grant topics ----
POWER_GRANT_TOPIC=DiscordAdminPowerGrantV1
POWER_REMOVE_TOPIC=DiscordAdminPowerRemoveV1
ADMIN_GRANT_TOPIC=DiscordAdminGrantV1
ADMIN_GRANT_REMOVE_TOPIC=DiscordAdminGrantRemoveV1

# ---- Database (same Postgres as the bot / perks-api) ----
DATABASE_URL=                    # postgresql://postgres:PASSWORD@HOST:PORT/railway (Railway public proxy URL)

# ---- Perks-api (crew tags) ----
PERKS_API_URL=https://idkutoldmetomakeit-production.up.railway.app
PERKS_API_SECRET=                # same value as the perks-api's PERKS_API_SECRET
